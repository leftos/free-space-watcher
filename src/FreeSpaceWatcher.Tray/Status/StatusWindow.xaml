<Window
  x:Class="FreeSpaceWatcher.Tray.Status.StatusWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:FreeSpaceWatcher.Tray.Controls"
  xmlns:local="clr-namespace:FreeSpaceWatcher.Tray.Status"
  Title="Free Space Watcher"
  Width="480"
  Height="640"
  MinWidth="420"
  MinHeight="320"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    <DataTemplate x:Key="DriveCard" DataType="{x:Type local:DriveCardViewModel}">
      <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel>
            <Border x:Name="WatchedPill" DockPanel.Dock="Right" Style="{StaticResource AccentPill}">
              <TextBlock Text="Watched" />
            </Border>
            <Border x:Name="NotWatchedPill" DockPanel.Dock="Right" Style="{StaticResource Pill}" Visibility="Collapsed">
              <TextBlock Text="Not watched" />
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Title}" />
              <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionText}"
                Text="{Binding VolumeLabel}"
                TextTrimming="CharacterEllipsis"
              />
            </StackPanel>
          </DockPanel>
          <TextBlock x:Name="FreeLine" Margin="0,12,0,0" Style="{StaticResource BodyText}">
            <Run Text="{Binding FreeText, Mode=OneWay}">
              <Run.Style>
                <Style TargetType="Run">
                  <Setter Property="FontSize" Value="20" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWatched}" Value="False">
                      <Setter Property="FontSize" Value="14" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Run.Style>
            </Run>
            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="free of" />
            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TotalText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock x:Name="NotAvailableLine" Margin="0,12,0,0" Style="{StaticResource BodyText}" Text="Not available" Visibility="Collapsed" />
          <controls:FreeSpaceBar Margin="0,8,0,0" Severity="{Binding Severity}" UsedFraction="{Binding UsedFraction}" />
          <TextBlock
            x:Name="RateLine"
            Margin="0,8,0,0"
            Style="{StaticResource CaptionText}"
            Text="{Binding RateText}"
            TextTrimming="CharacterEllipsis"
          />
          <TextBlock x:Name="HistoryCaption" Margin="0,12,0,0" Style="{StaticResource CaptionText}" Text="Free space · last 10 min" />
          <controls:Sparkline x:Name="History" Margin="0,4,0,0" FloorBytes="{Binding FloorBytes}" Samples="{Binding History}" />
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsWatched}" Value="False">
          <Setter TargetName="Card" Property="Padding" Value="12" />
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
          <Setter TargetName="WatchedPill" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="NotWatchedPill" Property="Visibility" Value="Visible" />
          <Setter TargetName="RateLine" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="HistoryCaption" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="History" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter TargetName="FreeLine" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="NotAvailableLine" Property="Visibility" Value="Visible" />
          <Setter TargetName="RateLine" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLosing}" Value="True">
          <Setter TargetName="RateLine" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="24,16,24,12">
      <TextBlock Style="{StaticResource TitleText}" Text="Free Space Watcher" />
      <DockPanel Margin="0,4,0,0">
        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectionSeverity}" Value="{x:Static local:DriveSeverity.Caution}">
                  <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectionSeverity}" Value="{x:Static local:DriveSeverity.Critical}">
                  <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock
          Style="{StaticResource CaptionText}"
          Text="{Binding ConnectionText}"
          TextTrimming="CharacterEllipsis"
          ToolTip="{Binding ConnectionText}"
        />
      </DockPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button MinWidth="96" Command="{Binding ShowAlertsCommand}" Content="{Binding AlertsButtonText}" />
        <Button MinWidth="96" Margin="8,0,0,0" Command="{Binding ShowSettingsCommand}" Content="Settings" />
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,12">
        <TextBlock
          Style="{StaticResource CaptionText}"
          Text="No drive status yet."
          Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}"
        />
        <ItemsControl ItemTemplate="{StaticResource DriveCard}" ItemsSource="{Binding Drives}" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
