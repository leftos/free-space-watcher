<Window
  x:Class="FreeSpaceWatcher.Tray.Settings.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:FreeSpaceWatcher.Tray.Controls"
  xmlns:local="clr-namespace:FreeSpaceWatcher.Tray.Settings"
  Title="Settings"
  Width="760"
  Height="800"
  MinWidth="640"
  MinHeight="560"
  WindowStartupLocation="CenterScreen"
>
  <Window.Resources>
    <local:OverrideChoiceConverter x:Key="OverrideChoice" />
    <local:DefaultChoiceConverter x:Key="DefaultChoice" />

    <!-- A number field: the text box with its default as placeholder, the unit to its right, and its error under it. -->
    <DataTemplate DataType="{x:Type local:NumberField}">
      <StackPanel Margin="0,0,16,0">
        <StackPanel Orientation="Horizontal">
          <Grid Width="96">
            <TextBox x:Name="Box" VerticalContentAlignment="Center" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
              x:Name="Hint"
              Margin="11,0,0,0"
              VerticalAlignment="Center"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              IsHitTestVisible="False"
              Text="{Binding Placeholder}"
              Visibility="Collapsed"
            />
          </Grid>
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding Unit.Label}" />
        </StackPanel>
        <TextBlock
          x:Name="ErrorText"
          MaxWidth="200"
          Margin="0,4,0,0"
          HorizontalAlignment="Left"
          Style="{StaticResource CriticalCaptionText}"
          Text="{Binding Error}"
          TextWrapping="Wrap"
          Visibility="Collapsed"
        />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasError}" Value="True">
          <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
          <Setter TargetName="ErrorText" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Margin" Value="0,6,16,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="FormChoice" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Width" Value="132" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="FormRow" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- The help under the Cleanup row: one caption line per setting. -->
    <Style x:Key="CleanupHelp" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,4,0,0" />
      <Style.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
          <Setter Property="TextWrapping" Value="Wrap" />
          <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
      </Style.Resources>
    </Style>

    <!-- A drive's card: letter and label, the watch check box, the free-space bar, and its custom thresholds. -->
    <DataTemplate x:Key="DriveCard" DataType="{x:Type local:DriveRow}">
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel>
            <CheckBox
              DockPanel.Dock="Right"
              VerticalAlignment="Center"
              Content="Watch this drive"
              IsChecked="{Binding Watched, UpdateSourceTrigger=PropertyChanged}"
            />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource SubtitleText}" Text="{Binding Label}" />
              <TextBlock Margin="8,0,16,0" Style="{StaticResource SubtitleText}" Text="{Binding VolumeLabel}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <controls:FreeSpaceBar Margin="0,12,0,0" Severity="{Binding Severity}" UsedFraction="{Binding UsedFraction}" />
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Style="{StaticResource CaptionText}" Text="{Binding RateLine}" />
            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding FreeText}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Expander Margin="0,12,0,0" Header="Custom thresholds" IsExpanded="{Binding ThresholdsExpanded}">
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Drop rate" />
              <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormRow}">
                <ComboBox
                  Style="{StaticResource FormChoice}"
                  ItemsSource="{x:Static local:TriggerChoice.OverrideLabels}"
                  SelectedIndex="{Binding DropRateEnabled, Mode=TwoWay, Converter={StaticResource OverrideChoice}}"
                  AutomationProperties.Name="Drop rate trigger"
                />
                <ContentControl Content="{Binding DropRate}" AutomationProperties.Name="Drop rate" />
              </StackPanel>
              <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Time to full" />
              <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormRow}">
                <ComboBox
                  Style="{StaticResource FormChoice}"
                  ItemsSource="{x:Static local:TriggerChoice.OverrideLabels}"
                  SelectedIndex="{Binding TimeToFullEnabled, Mode=TwoWay, Converter={StaticResource OverrideChoice}}"
                  AutomationProperties.Name="Time to full trigger"
                />
                <ContentControl Content="{Binding TimeToFull}" AutomationProperties.Name="Time to full" />
              </StackPanel>
              <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Noise floor" />
              <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormRow}">
                <ContentControl Margin="148,0,0,0" Content="{Binding NoiseFloor}" AutomationProperties.Name="Noise floor" />
              </StackPanel>
              <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Floor" />
              <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FormRow}">
                <ComboBox
                  Style="{StaticResource FormChoice}"
                  ItemsSource="{x:Static local:TriggerChoice.OverrideLabels}"
                  SelectedIndex="{Binding FloorEnabled, Mode=TwoWay, Converter={StaticResource OverrideChoice}}"
                  AutomationProperties.Name="Floor trigger"
                />
                <ContentControl Content="{Binding FloorBytes}" AutomationProperties.Name="Floor in GB" />
                <ContentControl Content="{Binding FloorPercent}" AutomationProperties.Name="Floor in percent" />
              </StackPanel>
              <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Process write" />
              <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource FormRow}">
                <ComboBox
                  Style="{StaticResource FormChoice}"
                  ItemsSource="{x:Static local:TriggerChoice.OverrideLabels}"
                  SelectedIndex="{Binding ProcessWriteEnabled, Mode=TwoWay, Converter={StaticResource OverrideChoice}}"
                  AutomationProperties.Name="Process write trigger"
                />
                <ContentControl Content="{Binding ProcessWrite}" AutomationProperties.Name="Process write" />
              </StackPanel>
              <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Cleanup" />
              <StackPanel Grid.Row="5" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource FormLabel}" Text="Grace delay" />
                  <ContentControl Content="{Binding GraceDelay}" AutomationProperties.Name="Grace delay" />
                  <TextBlock Style="{StaticResource FormLabel}" Text="Auto-resolve window" />
                  <ContentControl Content="{Binding ResolveWindow}" AutomationProperties.Name="Auto-resolve window" />
                </StackPanel>
                <StackPanel Style="{StaticResource CleanupHelp}">
                  <TextBlock Text="A drop-rate or time-to-full alert waits this long, and is dropped if the writer deletes what it wrote." />
                  <TextBlock Text="An alert is marked resolved if its writers delete what they wrote within this time." />
                  <TextBlock Text="0 turns either off." />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Expander>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="24,16,24,12" Style="{StaticResource TitleText}" Text="Settings" />

    <Border DockPanel.Dock="Top" Margin="24,0,24,12">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource InfoStrip}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasLoadError}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel>
        <TextBlock Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" Style="{StaticResource GlyphText}" Text="&#xE7BA;" />
        <TextBlock
          VerticalAlignment="Center"
          Style="{StaticResource BodyText}"
          Text="{Binding LoadError, StringFormat='config.json could not be used, so the defaults are shown: {0}'}"
          TextWrapping="Wrap"
        />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Orientation="Horizontal">
          <Button MinWidth="96" Content="Save" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveCommand}" />
          <Button MinWidth="96" Margin="8,0,0,0" Content="Cancel" Click="OnCloseClick" />
        </StackPanel>
        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Errors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource CriticalText}" Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Not connected to the service; saving is disabled." TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,24" Grid.IsSharedSizeScope="True">
        <TextBlock Style="{StaticResource SubtitleText}" Text="Drives" />
        <TextBlock
          Margin="0,4,0,12"
          Style="{StaticResource CaptionText}"
          Text="Custom thresholds apply to one drive; a blank field uses the default shown in it."
          TextWrapping="Wrap"
        />
        <ItemsControl ItemTemplate="{StaticResource DriveCard}" ItemsSource="{Binding Drives}" />

        <TextBlock Margin="0,12,0,12" Style="{StaticResource SubtitleText}" Text="Defaults" />
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Drop rate" />
            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormRow}">
              <ComboBox
                Style="{StaticResource FormChoice}"
                ItemsSource="{x:Static local:TriggerChoice.DefaultLabels}"
                SelectedIndex="{Binding DefaultDropRateEnabled, Mode=TwoWay, Converter={StaticResource DefaultChoice}}"
                AutomationProperties.Name="Drop rate trigger by default"
              />
              <ContentControl Content="{Binding DefaultDropRate}" AutomationProperties.Name="Default drop rate" />
            </StackPanel>
            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Time to full" />
            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormRow}">
              <ComboBox
                Style="{StaticResource FormChoice}"
                ItemsSource="{x:Static local:TriggerChoice.DefaultLabels}"
                SelectedIndex="{Binding DefaultTimeToFullEnabled, Mode=TwoWay, Converter={StaticResource DefaultChoice}}"
                AutomationProperties.Name="Time to full trigger by default"
              />
              <ContentControl Content="{Binding DefaultTimeToFull}" AutomationProperties.Name="Default time to full" />
            </StackPanel>
            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Noise floor" />
            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormRow}">
              <ContentControl Margin="148,0,0,0" Content="{Binding DefaultNoiseFloor}" AutomationProperties.Name="Default noise floor" />
            </StackPanel>
            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Floor" />
            <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FormRow}">
              <ComboBox
                Style="{StaticResource FormChoice}"
                ItemsSource="{x:Static local:TriggerChoice.DefaultLabels}"
                SelectedIndex="{Binding DefaultFloorEnabled, Mode=TwoWay, Converter={StaticResource DefaultChoice}}"
                AutomationProperties.Name="Floor trigger by default"
              />
              <ContentControl Content="{Binding DefaultFloorBytes}" AutomationProperties.Name="Default floor in GB" />
              <ContentControl Content="{Binding DefaultFloorPercent}" AutomationProperties.Name="Default floor in percent" />
            </StackPanel>
            <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="Process write" />
            <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource FormRow}">
              <ComboBox
                Style="{StaticResource FormChoice}"
                ItemsSource="{x:Static local:TriggerChoice.DefaultLabels}"
                SelectedIndex="{Binding DefaultProcessWriteEnabled, Mode=TwoWay, Converter={StaticResource DefaultChoice}}"
                AutomationProperties.Name="Process write trigger by default"
              />
              <ContentControl Content="{Binding DefaultProcessWrite}" AutomationProperties.Name="Default process write" />
            </StackPanel>
            <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Cleanup" />
            <StackPanel Grid.Row="5" Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource FormLabel}" Text="Grace delay" />
                <ContentControl Content="{Binding DefaultGraceDelay}" AutomationProperties.Name="Default grace delay" />
                <TextBlock Style="{StaticResource FormLabel}" Text="Auto-resolve window" />
                <ContentControl Content="{Binding DefaultResolveWindow}" AutomationProperties.Name="Default auto-resolve window" />
              </StackPanel>
              <StackPanel Style="{StaticResource CleanupHelp}">
                <TextBlock Text="A drop-rate or time-to-full alert waits this long, and is dropped if the writer deletes what it wrote." />
                <TextBlock Text="An alert is marked resolved if its writers delete what they wrote within this time." />
                <TextBlock Text="0 turns either off." />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Expander Margin="0,24,0,0" Header="Advanced">
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FormLabel}" Text="Sample interval" />
            <ContentControl
              Grid.Row="0"
              Grid.Column="1"
              Margin="0,0,0,12"
              Content="{Binding SampleInterval}"
              AutomationProperties.Name="Sample interval"
            />
            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Rate window" />
            <ContentControl Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Content="{Binding RateWindow}" AutomationProperties.Name="Rate window" />
            <TextBlock Grid.Row="2" Style="{StaticResource FormLabel}" Text="Write window" />
            <ContentControl Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Content="{Binding WriteWindow}" AutomationProperties.Name="Write window" />
            <TextBlock Grid.Row="3" Style="{StaticResource FormLabel}" Text="Alert cooldown" />
            <ContentControl Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Content="{Binding Cooldown}" AutomationProperties.Name="Alert cooldown" />
            <TextBlock Grid.Row="4" Style="{StaticResource FormLabel}" Text="History" />
            <ContentControl Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Content="{Binding HistoryDays}" AutomationProperties.Name="History" />
            <TextBlock Grid.Row="5" Style="{StaticResource FormLabel}" Text="Processes per alert" />
            <ContentControl
              Grid.Row="5"
              Grid.Column="1"
              Margin="0,0,0,12"
              Content="{Binding TopProcesses}"
              AutomationProperties.Name="Processes per alert"
            />
            <TextBlock Grid.Row="6" Style="{StaticResource FormLabel}" Text="Folders per process" />
            <ContentControl
              Grid.Row="6"
              Grid.Column="1"
              Margin="0,0,0,12"
              Content="{Binding TopFolders}"
              AutomationProperties.Name="Folders per process"
            />
            <TextBlock Grid.Row="7" Style="{StaticResource FormLabel}" Text="Files per process" />
            <ContentControl Grid.Row="7" Grid.Column="1" Content="{Binding TopFiles}" AutomationProperties.Name="Files per process" />
          </Grid>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
