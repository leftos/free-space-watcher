<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:FreeSpaceWatcher.Tray.Controls"
>
  <!-- Type ramp: Title 20 semibold, Subtitle 14 semibold, Body 14, Caption 12 in the secondary text colour. -->
  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="SubtitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <!-- Errors: body or caption size in the critical colour. -->
  <Style x:Key="CriticalText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="CriticalCaptionText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <!-- A Segoe Fluent Icons glyph shown as text, e.g. an info strip's icon. -->
  <Style x:Key="GlyphText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- An info strip: a message on a severity background above the content it is about; caution unless a variant says otherwise. -->
  <Style x:Key="InfoStrip" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>
  <Style x:Key="CriticalInfoStrip" TargetType="Border" BasedOn="{StaticResource InfoStrip}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
  </Style>
  <Style x:Key="SuccessInfoStrip" TargetType="Border" BasedOn="{StaticResource InfoStrip}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
  </Style>

  <!-- A card: corner radius 8, the card background and stroke, 16 padding. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <!-- A state badge; AccentPill marks the state that matters. -->
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="TextElement.FontSize" Value="12" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="AccentPill" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="CautionPill" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
  </Style>
  <Style x:Key="SuccessPill" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
  </Style>

  <!--
    A Fluent button showing a Segoe Fluent Icons glyph: set controls:IconButton.Glyph and AutomationProperties.Name;
    the tooltip repeats the automation name.
  -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Content" Value="{Binding Path=(controls:IconButton.Glyph), RelativeSource={RelativeSource Self}}" />
    <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" />
  </Style>
  <!-- A smaller icon button for rows and info strips. -->
  <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <!-- Destructive actions (Kill, Clear all): the critical colour on the button's text or glyph. -->
  <Style x:Key="CriticalButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
  <Style x:Key="CriticalIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
  </Style>
</ResourceDictionary>
