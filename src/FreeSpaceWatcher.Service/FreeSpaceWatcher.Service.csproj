    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- The LibraryImport source generator emits unsafe marshalling code -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeSpaceWatcher.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeSpaceWatcher.Core\FreeSpaceWatcher.Core.csproj" />
    <ProjectReference Include="..\FreeSpaceWatcher.Native\FreeSpaceWatcher.Native.csproj" />
  </ItemGroup>
</Project>
